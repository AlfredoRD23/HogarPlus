generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  DIRECCION
  VENTAS
  COBRANZA
  INVENTARIO
  ADMINISTRACION
  TECNOLOGIA
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ClientLevel {
  INICIAL
  BRONCE
  PLATA
  ORO
}

enum CatalogTier {
  A
  B
  C
}

enum ProductCategory {
  SALUD_BIENESTAR
  BELLEZA
  HOGAR
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OfferType {
  DISCOUNT
  GIFT
  PROMO
}

enum ClientOfferStatus {
  ACTIVE
  USED
  CANCELLED
}

/// Oferta exclusiva: solo la ve y la usa un cliente.
model ClientOffer {
  id            String            @id @default(cuid())
  clientId      String
  productId     String
  offerType     OfferType
  offerDiscount Int?
  offerLabel    String?           @db.VarChar(120)
  offerEndsAt   DateTime?
  status        ClientOfferStatus @default(ACTIVE)
  usedCreditId  String?
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
  @@index([productId, status])
}

enum CreditStatus {
  DRAFT
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  PREPAID
}

enum PaymentMethod {
  CASH
  TRANSFER
  DEPOSIT
}

enum PaymentType {
  AFFILIATION
  INSTALLMENT
  ADVANCE
  DOWN_PAYMENT
}

enum PaymentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum PointsAction {
  WEEKLY_ON_TIME
  ADVANCE
  AFFILIATION
  REFERRAL
  PRODUCT_COMPLETED
  LATE_PAYMENT
}

enum ExpenseCategory {
  PAYROLL
  TRANSPORT
  MARKETING
  PROCESSING
  WARRANTY
  TAX
  OPERATIONS
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdClients     Client[]            @relation("ClientCreatedBy")
  createdCredits     Credit[]            @relation("CreditCreatedBy")
  createdPayments    Payment[]           @relation("PaymentCreatedBy")
  voidedPayments     Payment[]           @relation("PaymentVoidedBy")
  reviewedPaymentClaims PaymentClaim[]   @relation("PaymentClaimReviewedBy")
  inventoryMoves     InventoryMovement[]
  collectionNotes    CollectionNote[]
  expenses           Expense[]
  auditLogs          AuditLog[]
  notifications      InboxNotification[]

  @@index([role, active])
}

model Client {
  id              String       @id @default(cuid())
  code            String       @unique
  firstName       String
  lastName        String
  documentId      String       @unique
  phone           String
  email           String?
  address         String?      @db.Text
  city            String?
  province        String?
  status          ClientStatus @default(ACTIVE)
  points          Int          @default(0)
  level           ClientLevel  @default(INICIAL)
  catalogApproved Boolean      @default(false)
  affiliationPaid Boolean      @default(false)
  affiliationAt   DateTime?
  referredById    String?
  notes           String?      @db.Text
  locationUrl     String?      @db.Text
  referenceName   String?
  referencePhone  String?
  routeId         String?
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  referredBy     Client?           @relation("ClientReferrals", fields: [referredById], references: [id])
  referrals      Client[]          @relation("ClientReferrals")
  createdBy      User              @relation("ClientCreatedBy", fields: [createdById], references: [id])
  route          CollectionRoute?  @relation(fields: [routeId], references: [id])
  credits        Credit[]
  payments       Payment[]
  pointsLedger   PointsLedger[]
  collectionNotes CollectionNote[]
  productRequests ProductRequest[]
  paymentClaims   PaymentClaim[]
  images          ClientImage[]
  referralsMade   Referral[] @relation("ReferralsMade")
  fromReferral    Referral?  @relation("ReferralRegistered")
  exclusiveOffers ClientOffer[]

  @@index([status, level])
  @@index([phone])
  @@index([email])
  @@index([lastName, firstName])
  @@index([routeId])
}

model ClientImage {
  id           String   @id @default(cuid())
  clientId     String
  path         String
  originalName String?
  createdAt    DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model Product {
  id          String          @id @default(cuid())
  sku         String          @unique
  name        String
  description String?         @db.Text
  category    ProductCategory
  catalogTier CatalogTier
  cost        Decimal         @db.Decimal(12, 2)
  price       Decimal         @db.Decimal(12, 2)
  stock       Int             @default(0)
  minStock    Int             @default(2)
  status      ProductStatus   @default(ACTIVE)
  imageUrl    String?
  offerType     OfferType?
  offerDiscount Int?
  offerLabel    String?       @db.VarChar(120)
  offerEndsAt   DateTime?
  newUntil      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  credits            Credit[]
  inventoryMovements InventoryMovement[]
  productRequests    ProductRequest[]
  images             ProductImage[]
  clientOffers       ClientOffer[]

  @@index([category, catalogTier, status])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  path         String
  originalName String?
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model InventoryMovement {
  id        String                 @id @default(cuid())
  productId String
  type      InventoryMovementType
  quantity  Int
  unitCost  Decimal                @db.Decimal(12, 2)
  reason    String?
  creditId  String?
  userId    String
  createdAt DateTime               @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  credit  Credit? @relation(fields: [creditId], references: [id])

  @@index([productId, createdAt])
  @@index([type, createdAt])
}

model Credit {
  id             String       @id @default(cuid())
  code           String       @unique
  clientId       String
  productId      String
  price          Decimal      @db.Decimal(12, 2)
  cost           Decimal      @db.Decimal(12, 2)
  weeklyQuota    Decimal          @db.Decimal(12, 2)
  weeks          Int
  downPayment    Decimal          @db.Decimal(12, 2) @default(0)
  frequency      PaymentFrequency @default(WEEKLY)
  balance        Decimal          @db.Decimal(12, 2)
  affiliationFee Decimal      @db.Decimal(12, 2) @default(0)
  status         CreditStatus @default(ACTIVE)
  startDate      DateTime
  deliveredAt    DateTime?
  completedAt    DateTime?
  notes          String?      @db.Text
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  client      Client               @relation(fields: [clientId], references: [id])
  product     Product              @relation(fields: [productId], references: [id])
  createdBy   User                 @relation("CreditCreatedBy", fields: [createdById], references: [id])
  installments Installment[]
  payments    Payment[]
  inventoryMoves InventoryMovement[]
  collectionNotes CollectionNote[]
  pointsLedger PointsLedger[]
  paymentClaims PaymentClaim[]

  @@index([status, startDate])
  @@index([clientId, status])
}

model Installment {
  id         String             @id @default(cuid())
  creditId   String
  number     Int
  dueDate    DateTime
  amount     Decimal            @db.Decimal(12, 2)
  paidAmount Decimal            @db.Decimal(12, 2) @default(0)
  status     InstallmentStatus  @default(PENDING)
  /// Rebaja acumulada; `amount` ya la tiene descontada (original = amount + discountAmount).
  discountAmount Decimal        @db.Decimal(12, 2) @default(0)
  discountReason String?        @db.VarChar(200)
  discountedAt   DateTime?
  discountedById String?

  credit      Credit              @relation(fields: [creditId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@unique([creditId, number])
  @@index([dueDate, status])
}

model Payment {
  id               String        @id @default(cuid())
  code             String        @unique
  clientId         String
  creditId         String?
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod
  type             PaymentType
  reference        String?
  receiptPath      String?
  notes            String?       @db.Text
  createdById      String
  createdAt        DateTime      @default(now())
  voidedAt         DateTime?
  voidedById       String?
  voidReason       String?

  client      Client              @relation(fields: [clientId], references: [id])
  credit      Credit?             @relation(fields: [creditId], references: [id])
  createdBy   User                @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  voidedBy    User?               @relation("PaymentVoidedBy", fields: [voidedById], references: [id])
  allocations PaymentAllocation[]
  pointsLedger PointsLedger[]
  claim       PaymentClaim?

  @@index([createdAt])
  @@index([clientId, createdAt])
  @@index([voidedAt])
}

model PaymentAllocation {
  id            String  @id @default(cuid())
  paymentId     String
  installmentId String?
  amount        Decimal @db.Decimal(12, 2)

  payment     Payment      @relation(fields: [paymentId], references: [id])
  installment Installment? @relation(fields: [installmentId], references: [id])

  @@index([paymentId])
}

model PointsLedger {
  id        String       @id @default(cuid())
  clientId  String
  action    PointsAction
  points    Int
  creditId  String?
  paymentId String?
  note      String?
  createdAt DateTime     @default(now())

  client  Client   @relation(fields: [clientId], references: [id])
  credit  Credit?  @relation(fields: [creditId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([clientId, createdAt])
}

model CollectionNote {
  id        String   @id @default(cuid())
  clientId  String
  creditId  String?
  channel   String
  note      String   @db.Text
  nextFollowUp DateTime?
  userId    String
  createdAt DateTime @default(now())

  client Client  @relation(fields: [clientId], references: [id])
  credit Credit? @relation(fields: [creditId], references: [id])
  user   User    @relation(fields: [userId], references: [id])

  @@index([clientId, createdAt])
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String
  incurredOn  DateTime
  userId      String
  createdAt   DateTime        @default(now())
  voidedAt    DateTime?
  voidReason  String?

  user User @relation(fields: [userId], references: [id])

  @@index([incurredOn, category])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Sequence {
  name  String @id
  value Int    @default(0)
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  PRODUCT_REQUEST
  COLLECT_ME
  REFERRAL_LEAD
  REFERRAL_REGISTERED
  PAYMENT_CLAIM
}

enum PaymentClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model PaymentClaim {
  id           String             @id @default(cuid())
  clientId     String
  creditId     String
  amount       Decimal            @db.Decimal(12, 2)
  method       PaymentMethod
  receiptPath  String?
  notes        String?            @db.Text
  status       PaymentClaimStatus @default(PENDING)
  paymentId    String?            @unique
  reviewedById String?
  reviewedAt   DateTime?
  rejectReason String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  client     Client  @relation(fields: [clientId], references: [id])
  credit     Credit  @relation(fields: [creditId], references: [id])
  payment    Payment? @relation(fields: [paymentId], references: [id])
  reviewedBy User?   @relation("PaymentClaimReviewedBy", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([clientId, status])
  @@index([creditId, status])
}

enum ReferralStatus {
  PENDING
  REGISTERED
  CANCELLED
}

model Referral {
  id                 String         @id @default(cuid())
  referrerId         String
  firstName          String
  lastName           String
  phone              String
  status             ReferralStatus @default(PENDING)
  registeredClientId String?        @unique
  pointsAwarded      Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  referrer         Client  @relation("ReferralsMade", fields: [referrerId], references: [id])
  registeredClient Client? @relation("ReferralRegistered", fields: [registeredClientId], references: [id])

  @@index([phone, status])
  @@index([referrerId, createdAt])
}

model CollectionRoute {
  id        String   @id @default(cuid())
  name      String   @unique
  area      String?
  notes     String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clients   Client[]

  @@index([active, name])
}

model ProductRequest {
  id        String        @id @default(cuid())
  clientId  String
  productId String
  status    RequestStatus @default(PENDING)
  note      String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  client  Client  @relation(fields: [clientId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([status, createdAt])
  @@index([clientId, productId, status])
}

model InboxNotification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  clientId  String?
  productId String?
  requestId String?
  readAt    DateTime?
  emailSent Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt, createdAt])
}
